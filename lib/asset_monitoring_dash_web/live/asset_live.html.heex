<Layouts.app flash={@flash}>
  <section
    id="asset-detail-shell"
    class="min-h-screen text-app-fg"
  >
    <div class="mx-auto flex min-w-0 w-full max-w-7xl flex-col gap-6 px-4 py-6 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-4 border-b border-app-border pb-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="min-w-0">
          <.link
            id="back-to-dashboard"
            navigate={@return_to}
            class="inline-flex h-10 items-center rounded-app border border-app-border bg-app-surface px-3 text-sm font-medium text-app-muted transition hover:border-app-accent/40 hover:text-app-fg"
          >
            Back to dashboard
          </.link>

          <p class="mt-5 text-sm font-medium text-app-accent-2">Collateral asset inspection</p>
          <h1 class="mt-3 truncate font-display text-3xl font-semibold tracking-normal text-app-fg sm:text-4xl">
            {@asset.name}
          </h1>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-app-muted">
            Single-position view for review workflow, scenario checks, valuation signal quality, and risk drivers.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <Badge.render
            id="asset-detail-recommendation"
            label={@asset_risk_recommendation.label}
            tone={@asset_risk_recommendation.tone}
          />
          <Badge.render
            id="asset-detail-review-state"
            label={@asset_review_state.label}
            tone={@asset_review_state.tone}
          />
        </div>
      </div>

      <Tabs.render
        id="asset-detail-focus-nav"
        active={@asset_detail_focus}
        change_event="focus_asset_section"
        label="Asset detail focus"
        panel_id_prefix="asset-detail-tab"
        tab_id_prefix="asset-focus"
        tabs={@asset_detail_focus_options}
      />

      <div
        :if={@asset_detail_focus == "overview"}
        id="asset-detail-tab-overview"
        role="tabpanel"
        aria-labelledby="asset-focus-overview"
        class="grid min-w-0 gap-6"
      >
        <section
          id="asset-context-strip"
          aria-label="Asset context"
          class="grid min-w-0 gap-3 md:grid-cols-2 xl:grid-cols-4"
        >
          <Card.surface padding="p-4">
            <p class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-app-muted">
              Chain / game
            </p>
            <p id="asset-context-chain" class="mt-3 text-sm font-semibold text-app-fg">
              {@asset.chain}
            </p>
            <p id="asset-context-game" class="mt-1 truncate font-mono text-xs text-app-muted">
              {@asset.ecosystem}
            </p>
          </Card.surface>

          <Card.surface padding="p-4">
            <p class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-app-muted">
              Collateral class
            </p>
            <p id="asset-context-rarity" class="mt-3 text-sm font-semibold text-app-fg">
              {@asset.rarity}
            </p>
            <p id="asset-context-type" class="mt-1 truncate font-mono text-xs text-app-muted">
              {@asset.asset_type}
            </p>
          </Card.surface>

          <Card.surface padding="p-4">
            <p class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-app-muted">
              Position size
            </p>
            <p
              id="asset-context-value"
              class="mt-3 font-mono text-sm font-semibold tabular-nums text-app-fg"
            >
              {Formatters.usd(@asset.current_value_usd)} collateral
            </p>
            <p id="asset-context-loan" class="mt-1 font-mono text-xs text-app-muted">
              {Formatters.usd(@asset.loan_value_usd)} borrowed
            </p>
          </Card.surface>

          <Card.surface padding="p-4">
            <p class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-app-muted">
              Signal quality
            </p>
            <div class="mt-3 flex flex-wrap gap-2">
              <Badge.render
                id="asset-context-oracle"
                label={@asset.oracle_status}
                tone={signal_tone(@asset.oracle_status)}
              />
              <Badge.render
                id="asset-context-liquidity"
                label={@asset.liquidity_status}
                tone={signal_tone(@asset.liquidity_status)}
              />
            </div>
            <p id="asset-context-depth" class="mt-2 font-mono text-xs text-app-muted">
              {Formatters.usd(@asset.market_depth_usd)} market depth
            </p>
          </Card.surface>
        </section>

        <InvestigationBrief.render
          asset={@asset}
          health_factor={@asset_health_factor}
          risk_recommendation={@asset_risk_recommendation}
          review_state={@asset_review_state}
        />

        <AssetInspection.render
          asset={@asset}
          health_factor={@asset_health_factor}
          ltv_trend={@asset_ltv_trend}
          risk_recommendation={@asset_risk_recommendation}
          risk_explanation={@asset_risk_explanation}
          review_state={@asset_review_state}
        >
          <:actions>
            <Button.render
              id="apply-price-shock"
              phx-click="apply_price_shock"
              disabled={@asset_shocked?}
            >
              {price_shock_button_label(@asset_shocked?)}
            </Button.render>
            <Button.render
              id="reset-asset-scenario"
              phx-click="reset_asset_scenario"
              disabled={not @asset_shocked?}
            >
              Reset scenario
            </Button.render>

            <.form
              for={@review_action_form}
              id="review-action-form"
              phx-change="validate_review_action"
              phx-submit="submit_review_action"
              class="review-action-form mt-2 grid w-full gap-3 rounded-app border border-app-border bg-app-bg/45 p-3 shadow-[inset_0_1px_0_color-mix(in_oklch,var(--amd-fg),transparent_95%)]"
            >
              <div class="grid items-start gap-3 sm:grid-cols-[minmax(180px,0.75fr)_minmax(0,1.25fr)]">
                <.input
                  field={@review_action_form[:reason]}
                  type="select"
                  label="Review reason"
                  options={@review_reason_options}
                  class="h-10 w-full rounded-app border border-app-border bg-app-surface px-3 text-sm font-semibold text-app-fg outline-none transition hover:border-app-accent/35 focus:border-app-accent/50 focus:ring-2 focus:ring-app-accent/15"
                />
                <.input
                  field={@review_action_form[:note]}
                  type="textarea"
                  label="Operator note"
                  placeholder="Optional audit note"
                  rows="2"
                  maxlength="180"
                  class="h-20 w-full resize-none rounded-app border border-app-border bg-app-surface px-3 py-2 text-sm leading-5 text-app-fg outline-none transition placeholder:text-app-muted hover:border-app-accent/35 focus:border-app-accent/50 focus:ring-2 focus:ring-app-accent/15"
                />
              </div>

              <div class="flex flex-wrap gap-2 border-t border-app-border pt-3">
                <Button.render
                  id="mark-asset-reviewed"
                  type="submit"
                  name="review_action[action]"
                  value="reviewed"
                  disabled={@asset_reviewed?}
                  class="h-8 px-3"
                >
                  Mark reviewed
                </Button.render>
                <Button.render
                  id="escalate-asset-review"
                  type="submit"
                  name="review_action[action]"
                  value="escalated"
                  disabled={@asset_escalated?}
                  class="h-8 px-3"
                >
                  Escalate
                </Button.render>
              </div>
            </.form>
          </:actions>
        </AssetInspection.render>
      </div>

      <section
        :if={@asset_detail_focus == "activity"}
        id="asset-detail-tab-activity"
        role="tabpanel"
        aria-labelledby="asset-focus-activity"
        class="grid min-w-0 gap-4 xl:grid-cols-[minmax(0,1fr)_minmax(320px,0.45fr)]"
      >
        <AssetActivity.render
          active_filter_chips={@active_asset_event_filter_chips}
          event_count={@event_count}
          event_filter_form={@asset_event_filter_form}
          event_filters={@asset_event_filters}
          rows={@streams.events}
          source_filter_options={@asset_event_source_filter_options}
        />

        <ReviewHistory.render decisions={@review_history} />
      </section>

      <section
        :if={@asset_detail_focus == "related"}
        id="asset-detail-tab-related"
        role="tabpanel"
        aria-labelledby="asset-focus-related"
      >
        <RelatedAssets.render
          activity_sources={@asset_event_filters.sources}
          focus={@asset_detail_focus}
          related_assets={@related_assets}
          return_to={@return_to}
        />
      </section>
    </div>
  </section>
</Layouts.app>
