<Layouts.app flash={@flash}>
  <section
    id="dashboard-shell"
    class="min-h-screen text-app-fg"
  >
    <div class="mx-auto flex w-full max-w-7xl flex-col gap-8 px-4 py-6 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-4 border-b border-app-border pb-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
          <p class="text-sm font-medium text-app-accent-2">Cross-chain game asset monitoring</p>
          <h1 class="mt-3 font-display text-3xl font-semibold tracking-normal text-app-fg sm:text-4xl">
            Asset Risk Cockpit
          </h1>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-app-muted">
            A live operating view for game assets pledged as collateral across chains, starting with the four numbers that make the book legible: value, loans, yield, and liquidation pressure.
          </p>
        </div>

        <div
          id="dashboard-status"
          class="flex w-full items-center justify-between gap-3 rounded-app border border-app-border bg-app-surface px-4 py-3 text-sm shadow-app-panel lg:w-auto"
        >
          <span class="inline-flex items-center gap-2 text-app-fg">
            <span class="size-2 rounded-full bg-app-accent shadow-[0_0_14px_var(--amd-accent)]">
            </span>
            Demo data online
          </span>
          <span class="text-app-muted">Static snapshot</span>
        </div>
      </div>

      <section
        id="metric-strip"
        aria-label="Portfolio metrics"
        class="grid gap-4 md:grid-cols-2 xl:grid-cols-4"
      >
        <Card.render
          :for={card <- @metric_cards}
          id={card.id}
          label={card.label}
          context={card.context}
          value={card.value}
          delta={card.delta}
          delta_tone={card.delta_tone}
          description={card.description}
        />
      </section>

      <section class="grid gap-4 xl:grid-cols-[minmax(0,1.4fr)_minmax(360px,0.6fr)]">
        <div
          id="asset-monitor"
          class="min-h-72 rounded-app border border-app-border bg-app-surface p-5 shadow-app-panel"
        >
          <div class="flex items-center justify-between gap-4">
            <div>
              <h2 class="text-base font-semibold text-app-fg">Asset monitor</h2>
              <p class="mt-1 text-sm text-app-muted">
                Collateral assets grouped across chains, games, floor prices, and risk bands.
              </p>
            </div>
            <span
              id="asset-count"
              class="rounded-full bg-app-surface-2 px-3 py-1 text-xs font-medium text-app-muted ring-1 ring-app-border"
            >
              {length(@assets)} monitored
            </span>
          </div>

          <Table.render
            id="asset-list"
            label="Monitored assets"
            class="mt-5"
            grid_class="grid-cols-[minmax(180px,1.2fr)_minmax(130px,0.9fr)_90px_90px_70px_84px]"
            row_class="lg:min-w-[760px] lg:grid-cols-[minmax(180px,1.2fr)_minmax(130px,0.9fr)_90px_90px_70px_84px] lg:items-center"
          >
            <:col>Asset</:col>
            <:col>Chain / game</:col>
            <:col align={:right}>Floor</:col>
            <:col align={:right}>Value</:col>
            <:col align={:right}>LTV</:col>
            <:col align={:right}>Risk</:col>

            <:row
              :for={asset <- @assets}
              id={"asset-row-#{asset.id}"}
            >
              <AssetIdentity.render
                name={asset.name}
                caption={"#{asset.rarity} / #{asset.asset_type}"}
              />

              <div class="min-w-0">
                <p class="truncate text-sm font-medium text-app-fg">{asset.chain}</p>
                <p class="mt-1 truncate font-mono text-xs text-app-muted">{asset.ecosystem}</p>
              </div>

              <Table.cell label="Floor" align={:right}>
                <span class="font-mono text-sm font-semibold tabular-nums text-app-fg">
                  {Formatters.usd(asset.floor_price_usd)}
                </span>
              </Table.cell>

              <Table.cell label="Value" align={:right}>
                <span class="font-mono text-sm font-semibold tabular-nums text-app-fg">
                  {Formatters.usd(asset.current_value_usd)}
                </span>
              </Table.cell>

              <Table.cell label="LTV" align={:right}>
                <span class="font-mono text-sm font-semibold tabular-nums text-app-fg">
                  {Formatters.ltv(asset.ltv_percent)}
                </span>
              </Table.cell>

              <Table.cell label="Risk" align={:right} content_class="lg:flex lg:justify-end">
                <RiskBadge.render label={asset.risk_band} />
              </Table.cell>
            </:row>
          </Table.render>
        </div>

        <aside
          id="event-feed"
          class="min-h-72 rounded-app border border-app-border bg-app-surface p-5 shadow-app-panel"
        >
          <div class="flex items-center justify-between gap-4">
            <div>
              <h2 class="text-base font-semibold text-app-fg">Live event feed</h2>
              <p class="mt-1 text-sm text-app-muted">
                Soon this will stream deposits, transfers, price moves, and liquidation warnings.
              </p>
            </div>
            <span class="rounded-full bg-app-surface-2 px-3 py-1 text-xs font-medium text-app-muted ring-1 ring-app-border">
              Queued
            </span>
          </div>
        </aside>
      </section>
    </div>
  </section>
</Layouts.app>
