<Layouts.app flash={@flash}>
  <section
    id="dashboard-shell"
    class="min-h-screen bg-slate-950 text-slate-100"
  >
    <div class="mx-auto flex w-full max-w-7xl flex-col gap-8 px-4 py-6 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-4 border-b border-white/10 pb-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
          <p class="text-sm font-medium text-cyan-300">Cross-chain game asset monitoring</p>
          <h1 class="mt-3 text-3xl font-semibold tracking-normal text-white sm:text-4xl">
            Asset Risk Cockpit
          </h1>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-300">
            A live operating view for game assets pledged as collateral across chains, starting with the four numbers that make the book legible: value, loans, yield, and liquidation pressure.
          </p>
        </div>

        <div
          id="dashboard-status"
          class="flex w-full items-center justify-between gap-3 rounded-lg border border-white/10 bg-white/[0.04] px-4 py-3 text-sm shadow-sm lg:w-auto"
        >
          <span class="inline-flex items-center gap-2 text-slate-300">
            <span class="size-2 rounded-full bg-emerald-400 shadow-[0_0_14px_rgba(52,211,153,0.75)]">
            </span>
            Demo data online
          </span>
          <span class="text-slate-500">Static snapshot</span>
        </div>
      </div>

      <section
        id="metric-strip"
        aria-label="Portfolio metrics"
        class="grid gap-4 md:grid-cols-2 xl:grid-cols-4"
      >
        <article
          :for={card <- @metric_cards}
          id={card.id}
          class="group rounded-lg border border-white/10 bg-white/[0.055] p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-cyan-300/40 hover:bg-white/[0.075]"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-sm font-medium text-slate-400">{card.label}</p>
              <p class="mt-3 text-3xl font-semibold tracking-normal text-white">{card.value}</p>
            </div>
            <span class="rounded-md bg-cyan-300/10 p-2 text-cyan-200 ring-1 ring-cyan-300/20">
              <.icon name={card.icon} class="size-5" />
            </span>
          </div>

          <div class="mt-5 flex items-center gap-3">
            <span class={[
              "inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset",
              delta_class(card.delta_tone)
            ]}>
              {card.delta}
            </span>
            <p class="text-xs leading-5 text-slate-400">{card.description}</p>
          </div>
        </article>
      </section>

      <section class="grid gap-4 xl:grid-cols-[minmax(0,1.4fr)_minmax(360px,0.6fr)]">
        <div
          id="asset-monitor"
          class="min-h-72 rounded-lg border border-white/10 bg-white/[0.04] p-5"
        >
          <div class="flex items-center justify-between gap-4">
            <div>
              <h2 class="text-base font-semibold text-white">Asset monitor</h2>
              <p class="mt-1 text-sm text-slate-400">
                Next slice: a filterable list of chains, games, floor prices, and risk bands.
              </p>
            </div>
            <span class="rounded-full bg-slate-900 px-3 py-1 text-xs font-medium text-slate-400 ring-1 ring-white/10">
              Coming next
            </span>
          </div>
        </div>

        <aside
          id="event-feed"
          class="min-h-72 rounded-lg border border-white/10 bg-white/[0.04] p-5"
        >
          <div class="flex items-center justify-between gap-4">
            <div>
              <h2 class="text-base font-semibold text-white">Live event feed</h2>
              <p class="mt-1 text-sm text-slate-400">
                Soon this will stream deposits, transfers, price moves, and liquidation warnings.
              </p>
            </div>
            <span class="rounded-full bg-slate-900 px-3 py-1 text-xs font-medium text-slate-400 ring-1 ring-white/10">
              Queued
            </span>
          </div>
        </aside>
      </section>
    </div>
  </section>
</Layouts.app>
