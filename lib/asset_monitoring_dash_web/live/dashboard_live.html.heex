<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section
    id="dashboard-shell"
    class="min-h-screen text-app-fg"
  >
    <div class="mx-auto flex min-w-0 w-full max-w-7xl flex-col gap-8 px-4 py-6 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-4 border-b border-app-border pb-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
          <p class="text-sm font-medium text-app-accent-2">Cross-chain game asset monitoring</p>
          <h1 class="mt-3 font-display text-3xl font-semibold tracking-normal text-app-fg sm:text-4xl">
            Asset Risk Cockpit
          </h1>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-app-muted">
            A live operating view for game assets pledged as collateral across chains, starting with the four numbers that make the book legible: value, loans, yield, and liquidation pressure.
          </p>
        </div>

        <div class="flex w-full flex-wrap items-center gap-3 lg:w-auto lg:justify-end">
          <div
            id="dashboard-status"
            class="flex min-w-0 flex-1 items-center justify-between gap-3 rounded-app border border-app-border bg-app-surface px-4 py-3 text-sm shadow-app-panel lg:flex-none"
          >
            <span class="inline-flex items-center gap-2 text-app-fg">
              <span class="size-2 rounded-full bg-app-accent shadow-[0_0_14px_var(--amd-accent)]">
              </span>
              {@dashboard_mode.label}
            </span>
            <span class="text-app-muted">{@dashboard_mode.detail}</span>
          </div>
          <ThemeSwitch.render />
        </div>
      </div>

      <section
        id="metric-strip"
        aria-label="Portfolio metrics"
        class="grid min-w-0 gap-4 md:grid-cols-2 xl:grid-cols-4"
      >
        <Card.render
          :for={card <- @metric_cards}
          id={card.id}
          label={card.label}
          context={card.context}
          value={card.value}
          delta={card.delta}
          delta_tone={card.delta_tone}
          description={card.description}
        />
      </section>

      <Panel.render :if={!@demo_controls_enabled?} id="view-only-demo-banner">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-3xl">
            <p class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-app-muted">
              View-only demo
            </p>
            <h2 class="mt-2 font-display text-xl font-semibold tracking-normal text-app-fg">
              Explore the cockpit without changing demo state
            </h2>
            <p class="mt-2 text-sm leading-6 text-app-muted">
              Charts, filters, portfolio metrics, and the event feed are visible by default.
              Sign in to run simulator ticks, reset runtime state, and open asset review workflows.
            </p>
          </div>

          <div class="flex shrink-0 flex-wrap gap-2">
            <.link
              id="view-only-login-link"
              navigate={~p"/users/log-in"}
              class="inline-flex h-10 items-center justify-center rounded-app border border-app-accent/35 bg-app-accent/10 px-4 text-sm font-semibold text-app-accent transition hover:border-app-accent hover:bg-app-accent/15"
            >
              Log in
            </.link>
            <.link
              id="view-only-register-link"
              navigate={~p"/users/register"}
              class="inline-flex h-10 items-center justify-center rounded-app border border-app-border bg-app-surface-2 px-4 text-sm font-semibold text-app-muted transition hover:border-app-accent/40 hover:text-app-fg"
            >
              Register
            </.link>
          </div>
        </div>
      </Panel.render>

      <DemoWalkthrough.render
        :if={@demo_controls_enabled?}
        active_asset={@demo_walkthrough_asset}
        active_asset_path={@demo_walkthrough_asset_path}
        last_action={@last_simulator_action}
        progress={@demo_story_progress}
        scenario_count={@scenario_count}
        status={@simulator_status}
      />

      <SimulatorStatus.render
        :if={@demo_controls_enabled?}
        last_action={@last_simulator_action}
        scenario_count={@scenario_count}
        scenario_summary={@scenario_summary}
        status={@simulator_status}
      />

      <div
        id="analytics-toolbar"
        class="flex flex-col gap-3 border-b border-app-border pb-4 sm:flex-row sm:items-center sm:justify-between"
      >
        <div>
          <h2 class="font-display text-xl font-semibold tracking-normal text-app-fg">
            Portfolio analytics
          </h2>
          <p class="mt-1 text-sm text-app-muted">
            Database history, simulator events, and active scenario overlays.
          </p>
        </div>

        <div
          id="analytics-window-control"
          class="flex w-full gap-2 rounded-full border border-app-border bg-app-surface p-1 shadow-app-panel sm:w-auto"
        >
          <Button.render
            :for={window <- @analytics_window_options}
            id={"analytics-window-#{window.value}"}
            active={@analytics_window == window.value}
            aria-pressed={if(@analytics_window == window.value, do: "true", else: "false")}
            class="flex-1 border-0 px-4 sm:flex-none"
            phx-click="set_analytics_window"
            phx-value-window={window.value}
          >
            {window.label}
          </Button.render>
        </div>
      </div>

      <section id="dashboard-analytics" class="grid min-w-0 gap-4">
        <Panel.render id="portfolio-value-panel" class="p-6">
          <SectionHeader.render
            title="Portfolio value trend"
            description="Persisted collateral snapshots with the latest point adjusted by active scenarios."
          >
            <:actions>
              <span
                id="portfolio-value-total"
                class="rounded-full bg-app-surface-2 px-3 py-1 text-xs font-medium text-app-muted ring-1 ring-app-border"
              >
                {@portfolio_window_label}
              </span>
            </:actions>
          </SectionHeader.render>

          <.analytics_interpretation
            id="portfolio-value-interpretation"
            label={@portfolio_value_interpretation.label}
            tone={@portfolio_value_interpretation.tone}
          />

          <.analytics_summary id="portfolio-value-summary" items={@portfolio_value_summary} />

          <Chart.render
            id="portfolio-value-chart"
            option={@portfolio_value_chart_option}
            class="mt-4 h-80"
            aria-label="Portfolio collateral value trend chart"
          />
        </Panel.render>

        <section id="risk-analytics" class="grid min-w-0 gap-4 xl:grid-cols-2">
          <Panel.render id="portfolio-risk-panel">
            <SectionHeader.render
              title="Portfolio risk trend"
              description="Persisted aggregate risk history with the latest point adjusted by active scenarios."
            >
              <:actions>
                <span
                  id="portfolio-risk-total"
                  class="rounded-full bg-app-surface-2 px-3 py-1 text-xs font-medium text-app-muted ring-1 ring-app-border"
                >
                  {@portfolio_window_label}
                </span>
              </:actions>
            </SectionHeader.render>

            <.analytics_interpretation
              id="portfolio-risk-interpretation"
              label={@portfolio_risk_interpretation.label}
              tone={@portfolio_risk_interpretation.tone}
            />

            <.analytics_summary id="portfolio-risk-summary" items={@portfolio_risk_summary} />

            <Chart.render
              id="portfolio-risk-chart"
              option={@portfolio_risk_chart_option}
              class="mt-4 h-72"
              aria-label="Portfolio risk score trend chart"
            />
          </Panel.render>

          <Panel.render id="risk-pressure-panel">
            <SectionHeader.render
              title="Liquidation pressure"
              description="Collateral value distribution by risk tier after active scenario overlays."
            >
              <:actions>
                <span
                  id="risk-pressure-total"
                  class="rounded-full bg-app-surface-2 px-3 py-1 text-xs font-medium text-app-muted ring-1 ring-app-border"
                >
                  collateral mix
                </span>
              </:actions>
            </SectionHeader.render>

            <.analytics_interpretation
              id="risk-pressure-interpretation"
              label={@risk_pressure_interpretation.label}
              tone={@risk_pressure_interpretation.tone}
            />

            <.analytics_summary id="risk-pressure-summary" items={@risk_pressure_summary} />

            <Chart.render
              id="risk-pressure-chart"
              option={@risk_pressure_chart_option}
              class="mt-4 h-72"
              aria-label="Liquidation pressure by risk tier chart"
            />
          </Panel.render>
        </section>
      </section>

      <section class="grid min-w-0 gap-4">
        <AssetMonitor.render
          action_filter_options={@action_filter_options}
          active_filter_chips={@active_filter_chips}
          asset_count={@asset_count}
          asset_filters={@asset_filters}
          asset_loaded_count={@asset_loaded_count}
          asset_next_cursor={@asset_next_cursor}
          asset_sort={@asset_sort}
          asset_sort_options={@asset_sort_options}
          asset_summary={@asset_summary}
          asset_view_shared?={@asset_view_shared?}
          chain_filter_options={@chain_filter_options}
          demo_controls_enabled?={@demo_controls_enabled?}
          filter_form={@filter_form}
          operator_state_filter_options={@operator_state_filter_options}
          risk_filter_options={@risk_filter_options}
          rows={@streams.assets}
          scenario_count={@scenario_count}
        />

        <section id="operations-telemetry" class="grid min-w-0 gap-4 xl:grid-cols-2">
          <Panel.render id="event-volume-panel">
            <SectionHeader.render
              title="Recent event volume"
              description="System, scenario, and operator activity over the latest demo window."
            >
              <:actions>
                <span
                  id="event-volume-total"
                  class="rounded-full bg-app-surface-2 px-3 py-1 text-xs font-medium text-app-muted ring-1 ring-app-border"
                >
                  {@event_window_label}
                </span>
              </:actions>
            </SectionHeader.render>

            <.analytics_interpretation
              id="event-volume-interpretation"
              label={@event_volume_interpretation.label}
              tone={@event_volume_interpretation.tone}
            />

            <.analytics_summary id="event-volume-summary" items={@event_volume_summary} />

            <div class="relative">
              <Chart.render
                id="event-volume-chart"
                option={@event_volume_chart_option}
                class="mt-4 h-72"
                aria-label="Event volume by source chart"
              />

              <div
                :if={@event_volume_empty?}
                id="event-volume-empty"
                class="pointer-events-none absolute inset-x-0 top-1/2 mx-auto max-w-xs -translate-y-1/2 rounded-app border border-app-border bg-app-surface/95 px-4 py-3 text-center text-sm font-semibold text-app-muted shadow-app-panel"
              >
                No events in this window
              </div>
            </div>
          </Panel.render>

          <DashboardEventFeed.render
            active_event_filter_chips={@active_event_filter_chips}
            event_count={@event_count}
            event_filter_form={@event_filter_form}
            event_filters={@event_filters}
            event_source_filter_options={@event_source_filter_options}
            feed_paused={@feed_paused}
            rows={@streams.events}
          />
        </section>
      </section>
    </div>
  </section>
</Layouts.app>
